# Cloudflare static-assets headers. scripts/write-cf-routing.mjs appends the
# per-hook rules to the copy in out/ after the build.

# Next's content-hashed bundles.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Extensionless metadata image from app/opengraph-image.tsx.
/opengraph-image
  Content-Type: image/png

# llms route handlers sent text/plain.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/llms-guides.txt
  Content-Type: text/plain; charset=utf-8
/llms-hooks.txt
  Content-Type: text/plain; charset=utf-8
