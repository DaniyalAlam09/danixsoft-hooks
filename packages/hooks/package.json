{
  "name": "@danixsoft/hooks",
  "version": "0.1.1",
  "description": "The ultimate open-source, tree-shakeable React hooks library. 32+ essential, zero-dependency, isomorphic React hooks for modern applications (Next.js, Vite, SSR).",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "custom-hooks",
    "usehooks",
    "nextjs",
    "ssr",
    "typescript",
    "react-18",
    "danixsoft"
  ],
  "author": "DanixSoft <hello@danixsoft.com>",
  "homepage": "https://danixsoft-hooks-docs.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/danixsoft/hooks.git"
  },
  "bugs": {
    "url": "https://github.com/danixsoft/hooks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.55",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
