{
  "name": "@danixsoft/hooks",
  "version": "0.2.5",
  "license": "MIT",
  "description": "44 zero-dependency, SSR-safe React hooks with full TypeScript types: useLocalStorage, useDebounce, useMediaQuery, useClickOutside, useFetch, useForm and more. Tree-shakeable; works with Next.js, Remix and Vite.",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "react-hooks-library",
    "custom-hooks",
    "usehooks",
    "typescript",
    "typescript-hooks",
    "nextjs",
    "nextjs-hooks",
    "ssr",
    "ssr-safe",
    "zero-dependency",
    "tree-shakeable",
    "react-18",
    "react-19",
    "uselocalstorage",
    "usedebounce",
    "usemediaquery",
    "useclickoutside",
    "usefetch",
    "useform",
    "useintersectionobserver",
    "usewindowsize",
    "danixsoft"
  ],
  "author": "DanixSoft <hello@danixsoft.com>",
  "homepage": "https://react-hooks.danixsoft.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniyalAlam09/danixsoft-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/DaniyalAlam09/danixsoft-hooks/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:llms",
    "build:llms": "node scripts/generate-llms.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.55",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
